# Copiá este archivo a .env y ajustá lo que haga falta. .env no se commitea.
# Acá van solo nombres de variables y valores de desarrollo local: NUNCA secretos reales.

NODE_ENV=development
HOST=0.0.0.0
# Si el 3000 está ocupado en tu máquina, cambialo en tu .env (no acá).
PORT=3000
LOG_LEVEL=info

# Puerto del Postgres de Docker Compose en tu máquina.
POSTGRES_PORT=5434
DATABASE_URL=postgres://postgres:postgres@localhost:5434/bots_esteticas

# Base que usan los tests de integración (la crea docker/postgres/init).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/bots_esteticas_test
