# Copiá este archivo a .env y ajustá lo que haga falta. .env no se commitea.
# Acá van solo nombres de variables y valores de desarrollo local: NUNCA secretos reales.

NODE_ENV=development
HOST=0.0.0.0
# Si el 3000 está ocupado en tu máquina, cambialo en tu .env (no acá).
PORT=3000
LOG_LEVEL=info

# Puerto del Postgres de Docker Compose en tu máquina.
POSTGRES_PORT=5434
DATABASE_URL=postgres://postgres:postgres@localhost:5434/bots_esteticas

# Base que usan los tests de integración (la crea docker/postgres/init).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/bots_esteticas_test

# Clave que cifra las credenciales de terceros en la base: 32 bytes en base64.
# Esta (todos ceros) es SOLO para desarrollo: en producción el servidor no arranca con ella.
# Para generar una real: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# App de Meta (developers.facebook.com). Vacías en desarrollo = sin webhook de WhatsApp.
# WHATSAPP_APP_SECRET: "App secret" en la configuración básica de la app.
# WHATSAPP_VERIFY_TOKEN: lo inventás vos y lo cargás igual en Meta al registrar el webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0

# Solo para `pnpm whatsapp:connect <negocio>`: se guardan cifrados en la base y después
# se pueden borrar de acá.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# SOLO desarrollo, con el número de prueba de Meta: todo envío va a este número, escrito
# como figura en la lista de permitidos (los celulares argentinos con el 15, por ejemplo
# 54261155550000). Vacía = se contesta a quien escribió. En producción no se acepta.
WHATSAPP_TEST_RECIPIENT=
