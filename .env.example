# Copiá este archivo a .env y ajustá lo que haga falta. .env no se commitea.
# Acá van solo nombres de variables y valores de desarrollo local: NUNCA secretos reales.

NODE_ENV=development
HOST=0.0.0.0
# Si el 3000 está ocupado en tu máquina, cambialo en tu .env (no acá).
PORT=3000
LOG_LEVEL=info

# Puerto del Postgres de Docker Compose en tu máquina.
POSTGRES_PORT=5434
DATABASE_URL=postgres://postgres:postgres@localhost:5434/bots_esteticas

# Base que usan los tests de integración (la crea docker/postgres/init).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5434/bots_esteticas_test

# Clave que cifra las credenciales de terceros en la base: 32 bytes en base64.
# Esta (todos ceros) es SOLO para desarrollo: en producción el servidor no arranca con ella.
# Para generar una real: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# App de Meta (developers.facebook.com). Vacías en desarrollo = sin webhook de WhatsApp.
# WHATSAPP_APP_SECRET: "App secret" en la configuración básica de la app.
# WHATSAPP_VERIFY_TOKEN: lo inventás vos y lo cargás igual en Meta al registrar el webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0

# Solo para `pnpm whatsapp:connect <negocio>`: se guardan cifrados en la base y después
# se pueden borrar de acá.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# SOLO desarrollo, con el número de prueba de Meta: todo envío va a este número, escrito
# como figura en la lista de permitidos (los celulares argentinos con el 15, por ejemplo
# 54261155550000). Vacía = se contesta a quien escribió. En producción no se acepta.
WHATSAPP_TEST_RECIPIENT=

# SOLO desarrollo (sección 8.1): true manda con plantilla todo aviso que la tenga, sin probar antes
# el mensaje libre. Sirve para la prueba manual, donde la dueña y la clienta son el mismo celular.
# En producción no se acepta.
WHATSAPP_PREFER_TEMPLATES=

# El id de la cuenta de WhatsApp Business (WABA): lo usa `pnpm whatsapp:templates` para verificar
# las plantillas en Meta. Desde H15 se guarda con cada negocio.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Número de avisos del servicio (sección 8.2): de ahí salen los avisos a las dueñas (comprobantes,
# derivaciones, cancelaciones). Vacías = los avisos salen del número de cada negocio, como en la
# demo con el número de prueba de Meta. El token es un secreto: vacío acá.
NOTIFICATIONS_PHONE_NUMBER_ID=
NOTIFICATIONS_ACCESS_TOKEN=

# Modelo de IA que contesta las conversaciones (sección 8.5 de la especificación).
# ANTHROPIC_API_KEY: clave de la API de Claude (console.anthropic.com). Es un secreto: vacía acá,
# la cargás solo en tu .env. Sin ella, `pnpm dev` no contesta conversaciones, y en producción el
# servidor no arranca.
# ANTHROPIC_MODEL: por defecto claude-haiku-5-5. Cambiarlo obliga a repetir las evaluaciones.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Mercado Pago (sección 8.3): la aplicación del servicio en "Tus integraciones", una sola para todos
# los negocios. Las cuatro van juntas; vacías = sin Mercado Pago (los negocios cobran por transferencia).
# MERCADOPAGO_CLIENT_SECRET y MERCADOPAGO_WEBHOOK_SECRET son secretos: vacías acá.
# PUBLIC_BASE_URL: la URL https donde Mercado Pago nos encuentra (en desarrollo, el dominio de ngrok).
# La vuelta de OAuth es $PUBLIC_BASE_URL/mercadopago/oauth/callback: cargala igual en la aplicación.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# SOLO desarrollo: true pide tokens de las cuentas de prueba de Mercado Pago. En producción no se acepta.
MERCADOPAGO_TEST_TOKEN=

# Google Calendar (sección 8.4): la cuenta de servicio del servicio, una sola para todos los negocios.
# Es el JSON de la clave que descarga Google Cloud, en base64 (PowerShell:
# [Convert]::ToBase64String([IO.File]::ReadAllBytes("clave.json"))). Es un secreto: vacía acá.
# Vacía = sin calendario. Cada profesional comparte su calendario con el mail de la cuenta, con
# "Hacer cambios en eventos", y se conecta con `pnpm calendar:connect`.
GOOGLE_SERVICE_ACCOUNT_KEY=
