{
  "name": "bots-esteticas",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente de WhatsApp con IA para centros de estética de Mendoza",
  "type": "module",
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit --project contracts --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contracts": "vitest run --project contracts",
    "test:evals": "vitest run --project evals --reporter=default",
    "test:watch": "vitest --project unit --project contracts --project integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "whatsapp:connect": "tsx --env-file-if-exists=.env src/cli/connect-whatsapp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
